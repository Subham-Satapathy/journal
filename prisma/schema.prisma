generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trade {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  symbol       String
  side         String   // "LONG" | "SHORT" | "BUY" | "SELL"
  entryPrice   Float
  exitPrice    Float?
  quantity     Float
  pnl          Float?
  pnlPercent   Float?
  fees         Float    @default(0)
  date         DateTime
  closeDate    DateTime?
  exchange     String?
  notes        String?
  tags         String?
  importSource String?  // "csv" | "excel" | "screenshot" | "manual"
  orderId      String?  // Platform order/trade ID (UUID from broker) — used for deduplication
  currency     String   @default("USDT")  // "USDT" | "INR"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Deduplicate by broker order ID when present
  @@unique([orderId])
  @@index([userId, date])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  emailVerifiedAt DateTime?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  trades       Trade[]
  dailyPnls    DailyPnl[]
  emailOtps    EmailVerificationOtp[]
  hostedQuizzes      QuizSession[]
  quizParticipations QuizParticipant[]
}

model DailyPnl {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String   // IST day key: yyyy-MM-dd
  pnl        Float
  tradeCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model EmailVerificationOtp {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model BillingCustomer {
  id            String           @id @default(cuid())
  email         String           @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  subscriptions Subscription[]
  invoices      CryptoInvoice[]
}

model Subscription {
  id                 String          @id @default(cuid())
  customerId         String
  customer           BillingCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId             String
  billingCycle       String
  status             String          @default("inactive")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  activatedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([customerId, status])
}

model QuizSession {
  id                       String   @id @default(cuid())
  title                    String
  status                   String   @default("LOBBY") // LOBBY | QUESTION_ACTIVE | QUESTION_LOCKED | FINISHED
  currentQuestionIndex     Int      @default(0)
  currentQuestionStartedAt DateTime?
  hostId                   String
  host                     User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  questions    QuizQuestion[]
  participants QuizParticipant[]
  answers      QuizAnswer[]

  @@index([status])
}

model QuizQuestion {
  id                String      @id @default(cuid())
  sessionId         String
  session           QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order             Int
  text              String
  options           Json        // [{ id: string, text: string }, ...]
  correctOptionId   String
  timeLimitSeconds  Int         @default(20)
  basePoints        Int         @default(1000)
  createdAt         DateTime    @default(now())

  answers QuizAnswer[]

  @@unique([sessionId, order])
}

model QuizParticipant {
  id        String      @id @default(cuid())
  sessionId String
  session   QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int         @default(0)
  joinedAt  DateTime    @default(now())

  answers QuizAnswer[]

  @@unique([sessionId, userId])
  @@index([sessionId, score])
}

model QuizAnswer {
  id              String          @id @default(cuid())
  sessionId       String
  session         QuizSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId      String
  question        QuizQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  participantId   String
  participant     QuizParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  selectedOptionId String
  isCorrect       Boolean
  pointsAwarded   Int
  answeredAt      DateTime        @default(now())

  @@unique([questionId, participantId])
}

model CryptoInvoice {
  id                String          @id @default(cuid())
  customerId        String
  customer          BillingCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider          String
  providerInvoiceId String?
  orderId           String          @unique
  planId            String
  billingCycle      String
  status            String          @default("created")
  amountUsd         Float
  checkoutUrl       String?
  payCurrency       String?
  paymentId         String?
  paidAt            DateTime?
  rawPayload        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerId, status])
}
